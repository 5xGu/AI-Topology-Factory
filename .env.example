# API-routed model access for agentlib/llm.py
# Required if any node uses model_params.provider == "api".
BASE_URL=
API_KEY=

# Local (Ollama) model access for agentlib/llm.py
OLLAMA_BASE_URL=http://localhost:11434 #typical value

# Force all LLM calls to a single local model, bypassing per-node model_params entirely
# use e.g. for tight budget or smoke test
FORCE_LOCAL_LLM=0 #set to 1 to activate
FORCE_LOCAL_MODEL=qwen2.5:7b

# Precomputed token count lookup for agentlib/tokenization.py; 
# optional, is only used if you have precomputed a token-counts CSV and use tokenization during the graph's runtime
TOKEN_COUNTS_FILE=
SUB_DATA_ROOT=

# MLflow tracking destination; if unset, MLflow defaults to a local ./mlruns/ directory relative to the working directory
MLFLOW_TRACKING_URI=