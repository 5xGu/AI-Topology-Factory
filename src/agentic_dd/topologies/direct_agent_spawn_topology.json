      },
      "reads": [{"node": "chunk_split", "mode": "last"}]
    },
    {"name": "aggregator", "type": "aggregator"},
    {
      "name": "agent",
      "type": "llm",
      "params": {
        "tools": ["read_file", "delegate"],
