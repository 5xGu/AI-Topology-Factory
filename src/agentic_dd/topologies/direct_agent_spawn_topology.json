{
  "entry": "router",
  "nodes": [
    {
      "name": "router",
      "type": "router",
      "params": {
        "route": "free",
        "allowed_routes": ["direct", "agent", "spawn"],
        "fallback_route": "direct",
        "model_params": {"provider": "api", "model": "qwen3.8-27b", "temperature": 0.0}
      }
    },
    {"name": "read_file", "type": "read_file"},
    {
      "name": "chunk_split",
